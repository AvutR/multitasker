{
  "name": "multitasker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A UI editor layer atop Claude Code to maximize multitasking — run, steer, and review many parallel agent sessions, with skills-by-default and a policy-gated Slack/Notion/Linear/GitHub automation engine.",
  "author": "Unbound",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "electron-rebuild -f -o better-sqlite3",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm rebuild better-sqlite3",
    "test": "vitest run",
    "test:watch": "vitest",
    "rebuild:electron": "electron-rebuild -f -o better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "package": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder"
  },
  "build": {
    "appId": "ai.unbound.multitasker",
    "productName": "Multitasker",
    "directories": { "output": "release" },
    "files": ["out/**/*", "package.json"],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/@anthropic-ai/claude-agent-sdk/**"
    ],
    "npmRebuild": true,
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.150",
    "better-sqlite3": "^12.10.0",
    "chokidar": "^5.0.0",
    "monaco-editor": "^0.55.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-git": "^3.36.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.41",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "electron": "^30.5.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
